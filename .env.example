SIMIC_VAULT_PATH=/home/user/obsidian-vault
# SIMIC_STT_BACKEND=local                # local (default) or openai (needs si-mic[stt])
# SIMIC_STT_MODEL=large-v3-turbo         # openai default: whisper-1
# SIMIC_STT_API_KEY=                     # remote STT only (SIMIC_STT_BACKEND=openai)
# SIMIC_STT_CONCURRENCY=4
# SIMIC_STT_TIMEOUT=900                  # remote upload read/write timeout (seconds); keep high for diarize
# SIMIC_STT_MAX_RETRIES=5                # app-level retries per chunk on timeouts/5xx
# SIMIC_STT_RETRY_BASE_DELAY=5
# SIMIC_STT_HEARTBEAT_SECONDS=15
# SIMIC_STT_FFMPEG_TIMEOUT=120
# Deprecated: use SIMIC_STT_MODEL instead
# SIMIC_WHISPER_MODEL=large-v3-turbo
# SIMIC_LANGUAGE=en
# SIMIC_DEVICE=cuda
# SIMIC_COMPUTE_TYPE=auto
# SIMIC_BEAM_SIZE=5
# SIMIC_CHUNK_LENGTH=2
# SIMIC_PAUSE_THRESHOLD=1.0
# SIMIC_MONITOR_SOURCE=auto
# SIMIC_MIC_SOURCE=auto
# SIMIC_SESSIONS_DIR=/home/user/.local/state/simic/sessions
# SIMIC_TIMEZONE=UTC
# SIMIC_HF_TOKEN=hf_your_token_here
# SIMIC_DIARIZE=true
# SIMIC_MAX_SPEAKERS=
# SIMIC_CLUSTERING_THRESHOLD=
# SIMIC_SPECTRAL_MERGE_THRESHOLD=0.96
# SIMIC_SUMMARIZE=true
# SIMIC_LLM_PROVIDER=anthropic
# SIMIC_LLM_API_KEY=sk-ant-...
# SIMIC_LLM_MODEL=
#
# Free/cheap LLM providers (all OpenAI-compatible):
# SIMIC_LLM_PROVIDER=groq        # GROQ_API_KEY
# SIMIC_LLM_PROVIDER=gemini      # GEMINI_API_KEY
# SIMIC_LLM_PROVIDER=openrouter  # OPENROUTER_API_KEY
# SIMIC_LLM_PROVIDER=deepseek    # DEEPSEEK_API_KEY
# SIMIC_LLM_PROVIDER=qwen        # DASHSCOPE_API_KEY
