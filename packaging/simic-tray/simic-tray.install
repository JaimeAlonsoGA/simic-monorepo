_venv=/opt/simic

post_install() {
    echo "==> Installing tray dependencies into simic venv..."
    "$_venv/bin/pip" install --no-cache-dir "dbus-fast>=5.2,<6"
    echo "==> Done. Run 'simic tray' to start the system tray icon."
    echo "    GNOME users: install gnome-shell-extension-appindicator"
    echo "    and enable 'Ubuntu AppIndicators' for the icon to appear."
}

post_upgrade() {
    # Old installs put pystray + Pillow (<= 0.9.3) or dbus-next (<= 0.9.10) here;
    # dbus-next no longer imports on Python 3.15.
    "$_venv/bin/pip" uninstall -y dbus-next pystray Pillow 2>/dev/null || true
    post_install
}

pre_remove() {
    echo "==> Removing tray dependencies from simic venv..."
    "$_venv/bin/pip" uninstall -y dbus-fast dbus-next pystray Pillow 2>/dev/null || true
}
