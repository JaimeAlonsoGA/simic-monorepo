# Maintainer: Jaime Alonso <alonsog.jaime@gmail.com>
pkgname=simic-llm
pkgver=0.9.10
pkgrel=1
pkgdesc="LLM summarization support for simic (Anthropic, OpenAI, Gemini, etc.)"
arch=('any')
url="https://github.com/JaimeAlonsoGA/simic-monorepo"
license=('Apache-2.0')
depends=('simic')
install=simic-llm.install

# Meta-package: dependencies installed via .install hook into /opt/simic/ venv.

package() {
    install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgname/README" <<EOF
simic-llm: LLM summarization support for simic.
Pip dependencies installed into /opt/simic/ venv by install hook.
EOF
}
